# ============ 服务配置 ============
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
LOG_LEVEL=INFO

# ============ STT 配置 (语音转文字) ============
# HuggingFace 模型: openai/whisper-small
# 模型大小: tiny(~39MB) / base(~74MB) / small(~480MB, 推荐) / medium(~1.5GB)
WHISPER_MODEL_SIZE=small

# 模型缓存目录 (首次运行会自动从 HuggingFace 下载)
WHISPER_CACHE_DIR=./models

# 设备: cpu / cuda (有 GPU 选 cuda 更快)
WHISPER_DEVICE=cpu

# ============ TTS 配置 (文字转语音) ============
# 使用 edge-tts (微软免费高质量中文 TTS)
# 可选语音: zh-CN-XiaoxiaoNeural (女声), zh-CN-YunxiNeural (男声)
#           zh-CN-XiaoyiNeural (女声), zh-CN-YunjianNeural (男声)
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 默认语速倍率: 0.5(慢) ~ 1.0(正常) ~ 2.0(快)
TTS_SPEAKING_RATE=1.0

# 临时音频文件目录
TTS_OUTPUT_DIR=./audio_output
