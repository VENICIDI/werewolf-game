# ============================================================
# 狼人杀 ai-service Dockerfile（FastAPI + LangChain + ChromaDB）
# 生产环境版：使用远程 Embedding API，不需要 PyTorch
# ============================================================

FROM python:3.11-slim

WORKDIR /app

ENV TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# 先装依赖（缓存层）
COPY requirements.txt ./
ARG PIP_INDEX=https://mirrors.tencent.com/pypi/simple/

RUN pip install -i ${PIP_INDEX} "setuptools>=68,<80" "wheel<0.46"

# 跳过 sentence-transformers（不需要本地 PyTorch），装其余依赖
RUN grep -v "sentence-transformers" requirements.txt > requirements.prod.txt \
 && pip install -i ${PIP_INDEX} -r requirements.prod.txt \
 && rm requirements.prod.txt

# 拷业务代码
COPY . .

EXPOSE 8000

CMD ["python", "main.py"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
    CMD curl --fail http://127.0.0.1:8000/api/health || exit 1
