# ============ OpenAI 兼容 API 配置 ============
# 支持 OpenAI / Kimi / DeepSeek 等兼容格式
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
EMBEDDING_MODEL=text-embedding-3-small

# ============ Kimi 配置示例 ============
# OPENAI_API_KEY=sk-kimi-xxxx
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=kimi-k2-0711-preview

# ============ Ollama 配置（本地开发）============
# 启用本地模式请取消注释以下配置
# USE_LOCAL_LLM=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ============ AI 服务配置 ============
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO

# ============ ChromaDB 配置 ============
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_PREFIX=werewolf

# ============ Agent 配置 ============
MAX_AGENTS_PER_GAME=12
AGENT_MEMORY_TOKEN_LIMIT=2000
DEFAULT_PERSONA=analytical

# ============ LangChain 配置 ============
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=your-langsmith-key  # 可选，用于调试
