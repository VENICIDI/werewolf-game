{
  "name": "werewolf-game",
  "version": "1.0.0",
  "description": "基于 RAG 增强的 AI 狼人杀游戏平台",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "./setup.sh",
    "start": "./start.sh start",
    "stop": "./start.sh stop",
    "restart": "./start.sh restart",
    "status": "./start.sh status",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd packages/backend && ./mvnw spring-boot:run",
    "dev:frontend": "cd packages/frontend && npm run dev",
    "start:infra": "./start.sh infra",
    "start:backend": "./start.sh backend",
    "start:frontend": "./start.sh frontend",
    "start:ai": "./start.sh ai",
    "stop:infra": "./start.sh infra:stop",
    "stop:backend": "./start.sh backend:stop",
    "stop:frontend": "./start.sh frontend:stop",
    "stop:ai": "./start.sh ai:stop",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd packages/backend && ./mvnw clean package",
    "build:frontend": "cd packages/frontend && npm run build",
    "logs:backend": "./start.sh logs backend",
    "logs:frontend": "./start.sh logs frontend",
    "logs:ai": "./start.sh logs ai",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd packages/backend && ./mvnw test",
    "test:frontend": "cd packages/frontend && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
